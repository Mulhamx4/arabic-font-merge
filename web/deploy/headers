# Response headers for the static host.
#
# The page carries its own CSP in a <meta> tag so it is correct even when opened
# from a plain file server. Two directives cannot be delivered that way and must
# come from here:
#
#   frame-ancestors  — a meta CSP cannot carry it; without it the page can be
#                      framed by another site.
#   X-Content-Type-Options — unrelated to CSP, but cheap and worth having.
#
# Netlify/Cloudflare Pages read this file as `_headers`. Copy it to that name at
# the site root. The nginx equivalent is in deploy/nginx.conf.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; font-src 'self' blob: data:; img-src 'self' data: blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# The runtime is version-pinned in worker.js, so these may be cached hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
